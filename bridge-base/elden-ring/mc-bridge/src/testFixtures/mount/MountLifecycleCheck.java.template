package dev.ermc.bridge.mountfixture;

import java.util.*;
import net.minecraft.SharedConstants;
import net.minecraft.server.Bootstrap;
import net.minecraft.core.component.DataComponents;
import net.minecraft.world.SimpleContainer;
import net.minecraft.world.entity.EquipmentSlot;
import net.minecraft.world.entity.SlotAccess;
import net.minecraft.world.entity.animal.horse.AbstractHorse;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.Items;
import org.slf4j.LoggerFactory;

/** Production cleanup method bodies + player/horse/menu doubles, real MC item/container code.
 * This fixture is explicitly not a real Horse tick, world or network test. */
public final class MountLifecycleCheck {
    private static final List<Horse> RETIRED = new ArrayList<>();
    private static Horse active;
    private static ServerPlayer owner;
    private static int checks, publications;
    private static final class TerrainTravelClearance {
        static int invalidations;
        static void invalidate() { invalidations++; }
    }
    private static void publish(ServerPlayer player, Horse horse) { publications++; }

    /* PRODUCTION_METHODS */

    private static final class MinecraftServer {
        final Players players = new Players();
        Players getPlayerList() { return players; }
    }
    private static final class Players {
        final Map<UUID, ServerPlayer> current = new HashMap<>();
        ServerPlayer getPlayer(UUID id) { return current.get(id); }
        List<ServerPlayer> getPlayers() { return List.copyOf(current.values()); }
    }
    private record Slot(Object container) {}
    private static class Menu {
        final List<Slot> slots = new ArrayList<>();
        ItemStack carried = ItemStack.EMPTY;
        int broadcasts;
        ItemStack getCarried() { return carried; }
        void broadcastChanges() { broadcasts++; }
    }
    private static final class HorseInventoryMenu extends Menu {
        HorseInventoryMenu(Horse horse) { slots.add(new Slot(horse.saddle)); }
    }
    private static final class Inventory {
        final SimpleContainer delegate = new SimpleContainer(36);
        final List<ItemStack> items = delegate.getItems();
        int additions;
        void add(ItemStack stack) {
            additions++;
            ItemStack remainder = delegate.addItem(stack);
            stack.setCount(remainder.getCount());
            if (!remainder.isEmpty()) throw new AssertionError("Production capacity preflight allowed overflow");
        }
        void setChanged() { delegate.setChanged(); }
        long count(net.minecraft.world.item.Item item) { return items.stream().filter(s -> s.is(item)).mapToLong(ItemStack::getCount).sum(); }
    }
    private static final class ServerPlayer {
        final UUID uuid;
        final MinecraftServer server;
        final Inventory inventory = new Inventory();
        final Menu inventoryMenu = new Menu();
        Menu containerMenu = inventoryMenu;
        boolean alive = true, removed;
        int closes;
        ServerPlayer(MinecraftServer s, UUID id) { server = s; uuid = id; }
        UUID getUUID() { return uuid; }
        MinecraftServer getServer() { return server; }
        Inventory getInventory() { return inventory; }
        boolean isAlive() { return alive; }
        boolean isRemoved() { return removed; }
        void closeContainer() { closes++; containerMenu = inventoryMenu; }
    }
    private static final class Horse {
        final UUID ownerId;
        final SimpleContainer saddle = new SimpleContainer(1);
        final EnumMap<EquipmentSlot, ItemStack> equipment = new EnumMap<>(EquipmentSlot.class);
        boolean alive = true, removed, noAi;
        int ejects, discards;
        Horse(UUID id) {
            ownerId = id;
            saddle.setItem(0, new ItemStack(Items.SADDLE));
            for (EquipmentSlot slot : EquipmentSlot.values()) equipment.put(slot, ItemStack.EMPTY);
            ItemStack armor = new ItemStack(Items.IRON_HORSE_ARMOR);
            armor.set(DataComponents.CUSTOM_NAME, net.minecraft.network.chat.Component.literal("owner armor"));
            equipment.put(EquipmentSlot.BODY, armor);
        }
        boolean isAlive() { return alive; }
        boolean isRemoved() { return removed; }
        void ejectPassengers() { ejects++; }
        void setNoAi(boolean value) { noAi = value; }
        UUID getOwnerUUID() { return ownerId; }
        SlotAccess getSlot(int slot) {
            if (slot != AbstractHorse.EQUIPMENT_SLOT_OFFSET) throw new AssertionError("Unexpected horse inventory slot");
            return SlotAccess.forContainer(saddle, 0);
        }
        ItemStack getItemBySlot(EquipmentSlot slot) { return equipment.get(slot); }
        void setItemSlot(EquipmentSlot slot, ItemStack stack) { equipment.put(slot, stack); }
        boolean hasInventoryChanged(Object container) { return container != saddle; }
        void discard() { discards++; removed = true; }
    }

    private static void check(boolean ok, String label) { checks++; if (!ok) throw new AssertionError(label); }
    private static ServerPlayer join(MinecraftServer s, UUID id) {
        ServerPlayer player = new ServerPlayer(s, id); s.players.current.put(id, player); return player;
    }
    private static Horse ride(ServerPlayer player) {
        RETIRED.clear(); active = new Horse(player.uuid); owner = player; return active;
    }
    private static void retained(Horse horse, String label) {
        check(!horse.removed && horse.saddle.getItem(0).is(Items.SADDLE)
            && horse.equipment.get(EquipmentSlot.BODY).is(Items.IRON_HORSE_ARMOR), label);
    }
    private static void delivered(Horse horse, ServerPlayer player, String label) {
        check(horse.discards == 1 && horse.saddle.isEmpty() && horse.equipment.values().stream().allMatch(ItemStack::isEmpty)
            && player.inventory.count(Items.SADDLE) == 1 && player.inventory.count(Items.IRON_HORSE_ARMOR) == 1, label);
        ItemStack armor = player.inventory.items.stream().filter(s -> s.is(Items.IRON_HORSE_ARMOR)).findFirst().orElseThrow();
        check("owner armor".equals(armor.get(DataComponents.CUSTOM_NAME).getString()), "preserve actual custom equipment component");
    }
    public static void main(String[] args) {
        SharedConstants.tryDetectVersion(); Bootstrap.bootStrap();
        MinecraftServer server = new MinecraftServer(); UUID id = UUID.randomUUID();
        ServerPlayer first = join(server, id); Horse horse = ride(first);
        first.alive = false; release("death");
        retained(horse, "dead owner cannot consume equipment");
        check(active == null && owner == null && RETIRED.contains(horse) && horse.noAi && horse.ejects == 1, "death relinquishes ride and retains recovery entity");
        collectRetired(server); retained(horse, "dead instance stays ineligible");
        ServerPlayer replacement = join(server, id);
        check(!returnEquipment(horse, first), "old dead player rejected");
        first.alive = true;
        check(!returnEquipment(horse, first), "old live instance rejected after replacement");
        check(first.inventory.additions == 0, "no writes to replaced inventory");
        collectRetired(server); delivered(horse, replacement, "live replacement receives retained items once");
        int additions = replacement.inventory.additions;
        collectRetired(server); release("repeat");
        check(replacement.inventory.additions == additions && horse.discards == 1 && RETIRED.isEmpty(), "repeat cleanup cannot duplicate items");

        ServerPlayer removed = join(server, UUID.randomUUID()); horse = ride(removed); removed.removed = true;
        release("removed player"); retained(horse, "removed player retains items even while still in player list");
        ServerPlayer resumed = join(server, removed.uuid); collectRetired(server); delivered(horse, resumed, "removed replacement recovers once");
        ServerPlayer offline = join(server, UUID.randomUUID()); horse = ride(offline); server.players.current.remove(offline.uuid);
        release("disconnect after deregistration"); retained(horse, "deregistered owner not mutated");
        resumed = join(server, offline.uuid); collectRetired(server); delivered(horse, resumed, "reconnected owner recovers once");

        ServerPlayer full = join(server, UUID.randomUUID()); horse = ride(full);
        for (int i = 0; i < 36; i++) full.inventory.items.set(i, new ItemStack(Items.STONE, 64));
        release("full"); retained(horse, "full inventory keeps all gear on horse");
        full.inventory.items.set(0, ItemStack.EMPTY); collectRetired(server);
        retained(horse, "one free slot never partially transfers two items");
        check(full.inventory.additions == 0, "failed preflight performs zero transfers");
        full.inventory.items.set(1, ItemStack.EMPTY); collectRetired(server); delivered(horse, full, "two slots accept saddle and armor");

        ServerPlayer viewer = join(server, UUID.randomUUID()); horse = ride(viewer);
        HorseInventoryMenu menu = new HorseInventoryMenu(horse); menu.carried = new ItemStack(Items.DIAMOND); viewer.containerMenu = menu;
        release("cursor in menu"); retained(horse, "carried stack delays collection");
        check(viewer.closes == 0 && menu.carried.is(Items.DIAMOND), "do not force close or duplicate cursor stack");
        menu.carried = ItemStack.EMPTY; collectRetired(server); delivered(horse, viewer, "settled cursor permits collection");
        check(viewer.closes == 1, "close exactly the matching horse menu");

        ServerPlayer host = join(server, UUID.randomUUID()); horse = ride(host);
        Horse ordinary = new Horse(UUID.randomUUID());
        ServerPlayer guest = join(server, UUID.randomUUID());
        HorseInventoryMenu foreign = new HorseInventoryMenu(ordinary); foreign.carried = new ItemStack(Items.DIAMOND); guest.containerMenu = foreign;
        release("other horse viewer"); delivered(horse, host, "unrelated horse menu cannot block own recovery");
        retained(ordinary, "ordinary horse and its inventory remain untouched");
        check(ordinary.ejects == 0 && ordinary.discards == 0 && guest.closes == 0 && foreign.carried.is(Items.DIAMOND), "no ordinary-horse lifecycle or menu changes");

        ServerPlayer survivor = join(server, UUID.randomUUID()); horse = ride(survivor);
        // Vanilla death may leave references in the corpse inventory after spawning drops.
        horse.alive = false; release("horse already dropped equipment");
        check(survivor.inventory.additions == 0 && horse.discards == 0 && RETIRED.isEmpty(), "dead horse loot is never returned a second time");
        RETIRED.add(horse); collectRetired(server);
        check(survivor.inventory.additions == 0 && RETIRED.isEmpty(), "retired dead horse also avoids duplicate death drops");
        check(publications > 0 && TerrainTravelClearance.invalidations > 0, "release preserves production notification/invalidation calls");
        System.out.println("PASS: " + checks + " production mount cleanup assertions with real MC stacks/containers");
        System.out.println("LIMIT: player, horse, menu and connection lifecycle are doubles; no real Horse, movement, Fabric event or game validation");
    }
}
